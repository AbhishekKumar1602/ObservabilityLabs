# Public local demo credentials. bootstrap.sh generates random values when .env is absent.
COMPOSE_PROJECT_NAME=fastapi-observability
APP_NAME=FastAPI Observability
APP_VERSION=1.0.0
ENVIRONMENT=local
SERVICE_NAME=fastapi-items
LOG_LEVEL=INFO
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=items
POSTGRES_USER=items_app
POSTGRES_PASSWORD=local-only-change-app-password
POSTGRES_ADMIN_PASSWORD=local-only-change-admin-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=local-only-change-redis-password
REDIS_TIMEOUT_SECONDS=0.25
REDIS_POOL_SIZE=10
CACHE_TTL_SECONDS=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_TIMEOUT_SECONDS=3
DEPENDENCY_PROBE_INTERVAL_SECONDS=15
STARTUP_ATTEMPTS=5
REQUEST_ID_HEADER=X-Request-ID
METRICS_ENABLED=true
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
TRACE_SAMPLE_RATIO=1.0
PYROSCOPE_ENABLED=true
PYROSCOPE_SERVER_ADDRESS=http://pyroscope:4040
PYROSCOPE_SAMPLE_RATE=100
DEMO_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-only-change-grafana-password
